# 버튼 페이지 접속용 PIN (해외 오피스 직원에게만 공유)
HOTLINE_PIN=change-me

# 이 서버의 공개 https 주소 (Twilio 가 콜백을 보냄). 끝에 / 없이
PUBLIC_BASE_URL=https://your-hotline.example.com

# Twilio — 세 값이 모두 없으면 "테스트 모드"로 실행되어 실제 전화는 걸리지 않음
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15551234567

# 선택 설정
# MAX_ATTEMPTS=3              # 1번을 안 누르면 최대 몇 번까지 걸지
# RETRY_DELAY_SECONDS=60      # 재시도 간격
# RING_TIMEOUT_SECONDS=30     # 벨 울리는 시간
# TTS_VOICE=Polly.Seoyeon     # 한국어 음성
# PORT=3000
